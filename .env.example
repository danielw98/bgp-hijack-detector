# Copy to .env (gitignored) beside docker-compose.yml; docker compose reads it on every call.
# A variable set in the shell wins over the file.

# Local port of the page (docker-compose.override.yml). start.bat picks a free one when unset.
BGP_PORT=8080

# Bearer token that lets the page edit the watched prefixes (docker-compose.server.yml).
# Empty: only a client on a private network may edit.
WATCH_TOKEN=
