<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BGPWatch</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BGPWatch.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Reading\readings.ro.md" LogicalName="readings.ro.md" WithCulture="false" />
    <EmbeddedResource Include="Reading\readings.en.md" LogicalName="readings.en.md" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Localization\strings.*.json" />
    <EmbeddedResource Include="Localization\strings.*.json" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BGPWatch.Core\BGPWatch.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>
</Project>
