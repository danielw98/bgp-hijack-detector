@page
@{
    ViewData["Title"] = "Rute furate, simulatorul";
    ViewData["BodyClass"] = "app";
}
@section Styles {
<link rel="stylesheet" href="~/static/app.css">
}
@section Scripts {
<script type="module" src="~/static/app.js"></script>
}
<header class="topbar">
  <a class="brand" href="~/">Rute furate</a>
  <nav class="views" aria-label="vederile aplicației">
    <a href="#simulator" data-view="simulator"><span class="num">1</span>Simulator</a>
    <a href="#2008" data-view="2008"><span class="num">2</span>YouTube 2008</a>
    <a href="#prefixe" data-view="prefixe"><span class="num">3</span>Prefixe</a>
    <a href="#verifica" data-view="verifica"><span class="num">4</span>Verifică</a>
  </nav>
  <p class="status">
    <span class="status-item"><span id="dot-lab" class="dot"></span><span id="lab-state">Rutere, se verifică</span></span>
    <span class="status-item"><span id="dot-data" class="dot"></span><span id="data-state">Flux, se verifică</span></span>
    <span id="updated" class="updated"></span>
  </p>
  <nav class="pages" aria-label="paginile proiectului"><a class="guide" href="~/ghid">Ghid</a><a class="guide" href="~/referinte">Referințe</a></nav>
</header>

<main class="workspace">
<section class="view sim-view" id="view-simulator">
  @await Html.PartialAsync("_Simulator")
</section>

<section class="view" id="view-2008" hidden>
<div class="view-head"><h2>YouTube, 24 februarie 2008</h2><span class="note">actualizările reale ale colectorului RIPE RIS rrc00, 18:45-21:05 UTC</span><a class="guide-link" href="~/ghid#s3">În ghid, §3</a></div>
<div class="view-body"><div class="inner">
  @await Html.PartialAsync("_Incident2008")
</div>
</div>
</section>

<section class="view" id="view-prefixe" hidden>
<div class="view-head"><h2>Istoricul unui prefix</h2><span class="note">ruta curentă și schimbările, la fiecare punct de observație</span><a class="guide-link" href="~/ghid#s4">În ghid, §4</a></div>
<div class="view-body">
<div class="inner">
  <div class="panel"><div class="controls"><label>prefix urmărit <select id="prefix-select"></select></label></div></div>
  <div class="panel"><div class="body lookup-result" id="prefix-head">Se încarcă...</div></div>
  <div class="panel"><h3>Ruta curentă la fiecare punct de observație</h3><div class="scroll-x" id="prefix-current"></div></div>
  <div class="panel"><h3>Schimbările, cele mai noi primele</h3><div class="scroll-x" id="prefix-changes"></div></div>
  <details class="raw"><summary>Date brute: starea curentă, schimbările și alertele prefixului</summary><pre id="raw-prefix"></pre></details>
</div>
</div>
</section>

<section class="view" id="view-verifica" hidden>
<div class="view-head"><h2>Un prefix real, astăzi</h2><span class="note">de la RIPEstat, serviciul public de date al RIPE NCC</span><a class="guide-link" href="~/ghid#s5">În ghid, §5</a></div>
<div class="view-body">
<div class="inner">
  <div class="panel">
    <form class="controls" id="lookup-form">
      <label>adresă sau prefix <input type="text" id="lookup-input" value="193.0.0.0/21" spellcheck="false" autocomplete="off"></label>
      <button type="submit" id="btn-lookup" class="btn">Caută</button>
      <button type="button" id="btn-self" class="btn outline">Adresa mea</button>
      <span id="lookup-msg" class="msg"></span>
    </form>
    <div class="body lookup-result" id="lookup-result"><p class="caption">Încearcă prefixul RIPE NCC de mai sus, sau apasă „Adresa mea”.</p></div>
  </div>
  <details class="raw"><summary>Date brute: răspunsul RIPEstat</summary><pre id="raw-lookup"></pre></details>
  <p class="appfoot">Verificarea unui prefix real este singura cerere către Internet și doar citește.</p>
</div>
</div>
</section>
</main>
