@page
@{
    ViewData["Title"] = "Rute furate, simulatorul";
    ViewData["BodyClass"] = "app";
}
@section Styles {
<link rel="stylesheet" href="~/static/app.css">
}
@section Scripts {
<script type="module" src="~/static/app.js"></script>
}
<header class="topbar">
  <a class="brand" href="~/">Rute furate</a>
  <nav class="views" aria-label="vederile aplicației">
    <a href="#simulator" data-view="simulator">Simulator</a>
    <a href="#2008" data-view="2008">YouTube 2008</a>
    <a href="#prefixe" data-view="prefixe">Prefixe</a>
    <a href="#verifica" data-view="verifica">Verifică</a>
    <a href="~/ghid" class="guide">Ghid</a>
  </nav>
  <p class="status"><span id="dot-lab" class="dot"></span>Rutere <span id="lab-state">se verifică</span>. <span id="dot-data" class="dot"></span>Flux <span id="data-state">se verifică</span>. <span id="updated"></span></p>
</header>

<main class="workspace">
<section class="view sim-view" id="view-simulator">
  @await Html.PartialAsync("_Simulator")
</section>

<section class="view scroll" id="view-2008" hidden>
<div class="inner">
  <div class="view-head"><h2>YouTube, 24 februarie 2008</h2><span class="note">actualizările reale ale colectorului RIPE RIS rrc00, 18:45-21:05 UTC</span><a class="guide-link" href="~/ghid#s3">Povestea, în ghid</a></div>
  <div class="panel">
    <div id="lanes" class="graphbox"></div>
    <div class="controls">
      <button id="btn-play" class="btn">Redă</button>
      <label class="scrub">18:45 <input type="range" id="scrub" min="0" max="8400" step="10" value="240" aria-label="momentul din incident"> 21:05</label>
      <span id="scrub-time" class="mono"></span>
    </div>
    <div class="body"><p class="caption" id="scrub-caption">Se încarcă...</p></div>
  </div>
  <div class="panel">
    <h3>Căile din înregistrare <span class="note">vecinii colectorului la stânga, cine predă ruta originii la mijloc, originile la dreapta; roșu către AS17557, verde către AS36561</span></h3>
    <div id="asgraph" class="graphbox"></div>
  </div>
  <div class="panel">
    <h3>Evenimentele documentate de RIPE NCC</h3>
    <ol class="events" id="events"></ol>
    <div class="body"><p class="caption" id="msg-2008">Se încarcă...</p></div>
  </div>
  <div class="panel">
    <h3>Prima observare a sub-prefixului deturnat, la fiecare vecin</h3>
    <div class="scroll-x" id="peers-2008"></div>
  </div>
  <details class="raw">
    <summary>Date brute: cronologia, numele AS-urilor și actualizările prefixelor YouTube</summary>
    <pre id="raw-2008"></pre>
    <div class="drawer-actions"><button id="btn-reload" class="btn outline small">Reîncarcă incidentul din fișiere</button><span class="msg">Șterge și rescrie rândurile incidentului; simulatorul nu este atins.</span></div>
  </details>
</div>
</section>

<section class="view scroll" id="view-prefixe" hidden>
<div class="inner">
  <div class="view-head"><h2>Istoricul unui prefix</h2><label>prefix urmărit <select id="prefix-select"></select></label><a class="guide-link" href="~/ghid#s4">Ce se păstrează, în ghid</a></div>
  <div class="panel"><div class="body lookup-result" id="prefix-head">Se încarcă...</div></div>
  <div class="panel"><h3>Ruta curentă la fiecare punct de observație</h3><div class="scroll-x" id="prefix-current"></div></div>
  <div class="panel"><h3>Schimbările, cele mai noi primele</h3><div class="scroll-x" id="prefix-changes"></div></div>
  <details class="raw"><summary>Date brute: starea curentă, schimbările și alertele prefixului</summary><pre id="raw-prefix"></pre></details>
</div>
</section>

<section class="view scroll" id="view-verifica" hidden>
<div class="inner">
  <div class="view-head"><h2>Un prefix real, astăzi</h2><span class="note">de la RIPEstat, serviciul public de date al RIPE NCC</span><a class="guide-link" href="~/ghid#s5">RPKI, în ghid</a></div>
  <div class="panel">
    <form class="controls" id="lookup-form">
      <label>adresă sau prefix <input type="text" id="lookup-input" value="193.0.0.0/21" spellcheck="false" autocomplete="off"></label>
      <button type="submit" id="btn-lookup" class="btn">Caută</button>
      <button type="button" id="btn-self" class="btn outline">Adresa mea</button>
      <span id="lookup-msg" class="msg"></span>
    </form>
    <div class="body lookup-result" id="lookup-result"><p class="caption">Încearcă prefixul RIPE NCC de mai sus, sau apasă „Adresa mea”.</p></div>
  </div>
  <details class="raw"><summary>Date brute: răspunsul RIPEstat</summary><pre id="raw-lookup"></pre></details>
  <p class="appfoot">Verificarea unui prefix real este singura cerere către Internet și doar citește.</p>
</div>
</section>
</main>
