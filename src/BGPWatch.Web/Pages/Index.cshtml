@page
@{
    ViewData["Title"] = T["app.title"];
    ViewData["BodyClass"] = "app";
    ViewData["Page"] = "app";
}
@section Styles {
<link rel="stylesheet" href="~/static/app.css">
}
@section Scripts {
<script type="module" src="~/static/app.js"></script>
}
@await Html.PartialAsync("_TopBar")

<main class="workspace">
<section class="view story-view" id="view-story">
  @await Html.PartialAsync("_Story")
</section>

<section class="view" id="view-2008" hidden>
<div class="view-head"><h2>@T["view.2008.title"]</h2><span class="note">@T["view.2008.note"]</span><a class="guide-link" href="~/guide#s3">@T["view.guide.s3"]</a></div>
<div class="view-body"><div class="inner">
  @await Html.PartialAsync("_Incident2008")
</div>
</div>
</section>

<section class="view" id="view-prefixes" hidden>
<div class="view-head"><h2>@T["view.prefixes.title"]</h2><span class="note">@T["view.prefixes.note"]</span><a class="guide-link" href="~/guide#s4">@T["view.guide.s4"]</a></div>
<div class="view-body">
<div class="inner">
  @await Html.PartialAsync("_Prefix")
</div>
</div>
</section>

<section class="view" id="view-lookup" hidden>
<div class="view-head"><h2>@T["view.lookup.title"]</h2><span class="note">@T["view.lookup.note"]</span><a class="guide-link" href="~/guide#s5">@T["view.guide.s5"]</a></div>
<div class="view-body">
<div class="inner">
  @await Html.PartialAsync("_Lookup")
</div>
</div>
</section>
</main>
