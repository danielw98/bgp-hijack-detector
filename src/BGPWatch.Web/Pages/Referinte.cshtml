@page
@using BGPWatch.Web.Reading
@inject ReadingList Reading
@{
    ViewData["Title"] = "Rute furate, referințele";
    ViewData["BodyClass"] = "app";
    var versions = Reading.Lineage.Specs;
    var updates = Reading.Updates.Specs;
}
@functions {
    static string Surse(int count)
    {
        return count == 1 ? "o sursă" : count % 100 is >= 1 and <= 19 ? $"{count} surse" : $"{count} de surse";
    }
}
@section Styles {
<link rel="stylesheet" href="~/static/app.css">
<link rel="stylesheet" href="~/static/refs.css">
}
@section Scripts {
<script type="module" src="~/static/refs.js"></script>
}
@{
    void Specs(IReadOnlyList<Spec> specs, string kind)
    {
        <ol class="refs-timeline @kind">
        @foreach (var spec in specs)
        {
            <li id="rfc-@spec.Rfc">
                <span class="refs-when">@spec.Year</span>
                <div>
                    <p class="refs-head"><a href="@spec.Link">RFC @spec.Rfc</a> <span class="@(spec.Version.Length > 0 ? "refs-label" : "refs-title")">@(spec.Version.Length > 0 ? spec.Version : spec.Title)</span></p>
                    <p class="refs-why">@ReadingList.Markup(spec.Change)</p>
                    <p class="refs-rel">@ReadingList.Markup(spec.Relation)</p>
                </div>
            </li>
        }
        </ol>
    }

    void Lineage()
    {
        <details class="refs-stage refs-lineage" id="genealogia">
            <summary>
                <span class="refs-num">@versions[0].Year-@versions[^1].Year</span>
                <span class="refs-name">@Reading.Lineage.Title</span>
                <span class="refs-strip">
                @foreach (var spec in versions)
                {
                    <span><b>@spec.Year</b> RFC @spec.Rfc</span>
                }
                </span>
            </summary>
            <div class="refs-body">
                @foreach (var paragraph in Reading.Lineage.Intro)
                {
                    <p class="refs-intro">@ReadingList.Markup(paragraph)</p>
                }
                @{ Specs(versions, "refs-major"); }
                <details class="refs-updates" id="actualizari">
                    <summary><span>@Reading.Updates.Title</span> <span class="refs-count">@updates.Count RFC-uri, @updates[0].Year-@updates[^1].Year</span></summary>
                    @foreach (var paragraph in Reading.Updates.Intro)
                    {
                        <p class="refs-intro">@ReadingList.Markup(paragraph)</p>
                    }
                    @{ Specs(updates, "refs-minor"); }
                </details>
            </div>
        </details>
    }
}
<header class="topbar">
  <a class="brand" href="~/">Rute furate</a>
  <nav class="views" aria-label="vederile aplicației">
    <a href="~/#simulator"><span class="num">1</span>Simulator</a>
    <a href="~/#2008"><span class="num">2</span>YouTube 2008</a>
    <a href="~/#prefixe"><span class="num">3</span>Prefixe</a>
    <a href="~/#verifica"><span class="num">4</span>Verifică</a>
  </nav>
  <nav class="pages" aria-label="paginile proiectului"><a class="guide" href="~/ghid">Ghid</a><a class="guide current" href="~/referinte" aria-current="page">Referințe</a></nav>
</header>

<main class="workspace">
<section class="view">
<div class="view-head"><h2>Referințe</h2><span class="note">lecturi pentru a învăța BGP și securitatea lui, în ordinea în care merită citite</span><a class="guide-link" href="~/ghid#s6">În ghid, §6</a></div>
<div class="view-body">
<div class="refs">
  <nav class="refs-index" aria-label="cuprinsul referințelor">
    <p class="refs-index-title">Cuprins</p>
    <ol>
      <li><a href="#incepe">Începe de aici</a></li>
      @foreach (var stage in Reading.Stages)
      {
        <li><a href="#etapa-@stage.Number"><span class="num">@stage.Number</span>@stage.Title</a></li>
        @if (stage.Number == Reading.LineageAfterStage)
        {
          <li><a href="#genealogia"><span class="num">RFC</span>@Reading.Lineage.Title</a></li>
        }
      }
    </ol>
  </nav>

  <div class="refs-main">
    <p class="refs-lede">@Surse(Reading.Sources.Count()) în @Reading.Stages.Count etape, fiecare sprijinită pe cea dinainte, și genealogia specificației BGP. Deschide o etapă ca să vezi sursele: titlul duce la text, anul spune când a apărut, rândul de sub el spune de ce merită citit.</p>

    <section class="refs-start" id="incepe">
      <h3>Începe de aici</h3>
      @foreach (var paragraph in Reading.StartHereIntro)
      {
        <p>@ReadingList.Markup(paragraph)</p>
      }
      <ol>
      @foreach (var pick in Reading.Picks)
      {
        <li><a href="#sursa-@pick.Source">@pick.Label</a>: @ReadingList.Markup(pick.Note)</li>
      }
      </ol>
    </section>

    @if (Reading.LineageAfterStage == 0)
    {
      Lineage();
    }
    @foreach (var stage in Reading.Stages)
    {
      <details class="refs-stage" id="etapa-@stage.Number">
        <summary>
          <span class="refs-num">Etapa @stage.Number</span>
          <span class="refs-name">@stage.Title</span>
          <span class="refs-count">@Surse(stage.Sources.Count)</span>
        </summary>
        <div class="refs-body">
          @foreach (var paragraph in stage.Intro)
          {
            <p class="refs-intro">@ReadingList.Markup(paragraph)</p>
          }
          <ol class="refs-sources">
          @foreach (var source in stage.Sources)
          {
            <li id="sursa-@source.Number">
              <span class="refs-n">@source.Number</span>
              <div>
                <p class="refs-head"><a href="@source.Link">@source.Title</a> <span class="refs-year">@source.Year</span></p>
                <p class="refs-why">@ReadingList.Markup(source.Summary)</p>
                <p class="refs-host">@source.Host</p>
              </div>
            </li>
          }
          </ol>
        </div>
      </details>
      @if (stage.Number == Reading.LineageAfterStage)
      {
        Lineage();
      }
    }
    <p class="appfoot">Lista completă, cu citările, conținutul, timpul de citire și secțiunile recomandate pentru fiecare sursă, este <code>docs/lecturi-bgp.md</code> din depozitul proiectului; pagina se generează din ea.</p>
  </div>
</div>
</div>
</section>
</main>
