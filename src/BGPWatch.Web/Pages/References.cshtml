@page
@using BGPWatch.Web.Reading
@inject IReadOnlyDictionary<Language, ReadingList> Readings
@{
    ViewData["Title"] = T["refs.title"];
    ViewData["BodyClass"] = "app";
    ViewData["Page"] = "references";
    var Reading = Readings[T.Language];
    var versions = Reading.Lineage.Specs;
    var updates = Reading.Updates.Specs;
}
@section Styles {
<link rel="stylesheet" href="~/static/app.css">
<link rel="stylesheet" href="~/static/refs.css">
}
@section Scripts {
<script type="module" src="~/static/refs.js"></script>
}
@{
    void Specs(IReadOnlyList<Spec> specs, string kind)
    {
        <ol class="refs-timeline @kind">
        @foreach (var spec in specs)
        {
            <li id="rfc-@spec.Rfc">
                <span class="refs-when">@spec.Year</span>
                <div>
                    <p class="refs-head"><a href="@spec.Link">RFC @spec.Rfc</a> <span class="@(spec.Version.Length > 0 ? "refs-label" : "refs-title")">@(spec.Version.Length > 0 ? spec.Version : spec.Title)</span></p>
                    <p class="refs-why">@ReadingList.Markup(spec.Change)</p>
                    <p class="refs-rel">@ReadingList.Markup(spec.Relation)</p>
                </div>
            </li>
        }
        </ol>
    }

    void Lineage()
    {
        <details class="refs-stage refs-lineage" id="lineage">
            <summary>
                <span class="refs-num">@versions[0].Year-@versions[^1].Year</span>
                <span class="refs-name">@Reading.Lineage.Title</span>
                <span class="refs-strip">
                @foreach (var spec in versions)
                {
                    <span><b>@spec.Year</b> RFC @spec.Rfc</span>
                }
                </span>
            </summary>
            <div class="refs-body">
                @foreach (var paragraph in Reading.Lineage.Intro)
                {
                    <p class="refs-intro">@ReadingList.Markup(paragraph)</p>
                }
                @{ Specs(versions, "refs-major"); }
                <details class="refs-updates" id="updates">
                    <summary><span>@Reading.Updates.Title</span> <span class="refs-count">@T.Format("refs.updates.count", ("count", updates.Count), ("from", updates[0].Year), ("to", updates[^1].Year))</span></summary>
                    @foreach (var paragraph in Reading.Updates.Intro)
                    {
                        <p class="refs-intro">@ReadingList.Markup(paragraph)</p>
                    }
                    @{ Specs(updates, "refs-minor"); }
                </details>
            </div>
        </details>
    }
}
@await Html.PartialAsync("_TopBar")

<main class="workspace">
<section class="view">
<div class="view-head"><h2>@T["nav.references"]</h2><span class="note">@T["refs.note"]</span><a class="guide-link" href="~/guide#s6">@T["view.guide.s6"]</a></div>
<div class="view-body">
<div class="refs">
  <nav class="refs-index" aria-label="@T["refs.index.label"]">
    <p class="refs-index-title">@T["refs.index"]</p>
    <ol>
      <li><a href="#start">@T["refs.start"]</a></li>
      @foreach (var stage in Reading.Stages)
      {
        <li><a href="#stage-@stage.Number"><span class="num">@stage.Number</span>@stage.Title</a></li>
        @if (stage.Number == Reading.LineageAfterStage)
        {
          <li><a href="#lineage"><span class="num">RFC</span>@Reading.Lineage.Title</a></li>
        }
      }
    </ol>
  </nav>

  <div class="refs-main">
    <p class="refs-lede">@T.Format("refs.lede", ("sources", T.Count(Reading.Sources.Count(), "refs.sources")), ("stages", Reading.Stages.Count))</p>

    <section class="refs-start" id="start">
      <h3>@T["refs.start"]</h3>
      @foreach (var paragraph in Reading.StartHereIntro)
      {
        <p>@ReadingList.Markup(paragraph)</p>
      }
      <ol>
      @foreach (var pick in Reading.Picks)
      {
        <li><a href="#source-@pick.Source">@pick.Label</a>: @ReadingList.Markup(pick.Note)</li>
      }
      </ol>
    </section>

    @if (Reading.LineageAfterStage == 0)
    {
      Lineage();
    }
    @foreach (var stage in Reading.Stages)
    {
      <details class="refs-stage" id="stage-@stage.Number">
        <summary>
          <span class="refs-num">@T.Format("refs.stage", ("n", stage.Number))</span>
          <span class="refs-name">@stage.Title</span>
          <span class="refs-count">@T.Count(stage.Sources.Count, "refs.sources")</span>
        </summary>
        <div class="refs-body">
          @foreach (var paragraph in stage.Intro)
          {
            <p class="refs-intro">@ReadingList.Markup(paragraph)</p>
          }
          <ol class="refs-sources">
          @foreach (var source in stage.Sources)
          {
            <li id="source-@source.Number">
              <span class="refs-n">@source.Number</span>
              <div>
                <p class="refs-head"><a href="@source.Link">@source.Title</a> <span class="refs-year">@source.Year</span></p>
                <p class="refs-why">@ReadingList.Markup(source.Summary)</p>
                <p class="refs-host">@source.Host</p>
              </div>
            </li>
          }
          </ol>
        </div>
      </details>
      @if (stage.Number == Reading.LineageAfterStage)
      {
        Lineage();
      }
    }
    <p class="appfoot">@T.Html("refs.foot")</p>
  </div>
</div>
</div>
</section>
</main>
