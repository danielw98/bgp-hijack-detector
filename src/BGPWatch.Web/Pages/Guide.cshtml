@page
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = T["guide.title"];
    ViewData["BodyClass"] = "guide";
    ViewData["Page"] = "guide";
    // Each chapter: its paragraphs and the story step whose map it shows (0 for none).
    var chapters = new[]
    {
        (Paragraphs: new[] { "p1", "p2", "p3" }, Step: 1),
        (Paragraphs: new[] { "p1", "p2" }, Step: 4),
        (Paragraphs: new[] { "p1", "p2", "p3" }, Step: 3),
        (Paragraphs: new[] { "p1", "p2" }, Step: 2),
        (Paragraphs: new[] { "p1", "p2" }, Step: 5),
        (Paragraphs: new[] { "p1", "p2" }, Step: 0),
    };

    // The story's map at a step, as the application drew it (scripts/export_figures.py), described for readers of the alt text.
    string Figure(int step, string alt)
    {
        var file = Env.WebRootFileProvider.GetFileInfo($"static/figures/step-{step}.{T.Code}.svg");
        using var reader = new StreamReader(file.CreateReadStream());
        return reader.ReadToEnd().Replace("<svg ", $"<svg role=\"img\" aria-label=\"{Html.Encode(alt)}\" ", StringComparison.Ordinal);
    }
}
@section Styles {
<link rel="stylesheet" href="~/static/app.css">
}
@await Html.PartialAsync("_TopBar")

<header class="col">
  <h1>@T["guide.title"]</h1>
  <p class="subtitle">@T["guide.subtitle"]</p>
  <p class="lede">@T.Html("guide.intro.map")</p>
</header>

<main>
<section class="col">
  <p>@T.Html("guide.intro.p1")</p>
  <p>@T.Html("guide.intro.p2")</p>
  <ol class="contents">
    @for (var n = 1; n <= chapters.Length; n++)
    {
      <li><a href="#s@(n)">@T[$"guide.s{n}.title"]</a></li>
    }
  </ol>
</section>

@for (var i = 0; i < chapters.Length; i++)
{
  var n = i + 1;
  var chapter = chapters[i];
  <section class="col chapter">
    <h2 id="s@(n)">@T[$"guide.s{n}.title"]</h2>
    @foreach (var p in chapter.Paragraphs)
    {
      <p>@T.Html($"guide.s{n}.{p}")</p>
    }
    @if (chapter.Step > 0)
    {
      <figure class="still">
        @Html.Raw(Figure(chapter.Step, T[$"guide.fig{n}.alt"]))
        <figcaption>@T[$"guide.fig{n}.title"]</figcaption>
      </figure>
      <p class="live"><a href="@Url.Content($"~/#step-{chapter.Step}")">@T[$"guide.s{n}.live"]</a></p>
    }
    @if (n == 6)
    {
      <dl class="glossary" id="glossary"></dl>
    }
  </section>
}
</main>

<footer class="col">@T["guide.footer"]</footer>
