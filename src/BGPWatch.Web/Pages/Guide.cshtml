@page
@{
    ViewData["Title"] = T["guide.title"];
    ViewData["BodyClass"] = "guide";
    var chapters = new[]
    {
        (Paragraphs: new[] { "p1", "p2", "p3" }, Figure: "path", Width: 600, Height: 301, Step: 1),
        (Paragraphs: new[] { "p1", "p2" }, Figure: "exact", Width: 600, Height: 195, Step: 4),
        (Paragraphs: new[] { "p1", "p2", "p3" }, Figure: "subprefix", Width: 984, Height: 494, Step: 3),
        (Paragraphs: new[] { "p1", "p2" }, Figure: "rest", Width: 984, Height: 494, Step: 4),
        (Paragraphs: new[] { "p1", "p2" }, Figure: "defence", Width: 600, Height: 325, Step: 5),
        (Paragraphs: new[] { "p1", "p2", "p3" }, Figure: "packet", Width: 984, Height: 494, Step: 2),
    };
}
<header class="col">
  <p class="lang-row">@await Html.PartialAsync("_Language")</p>
  <h1>@T["brand"]</h1>
  <p class="subtitle">@T["guide.subtitle"]</p>
  <p class="status"><span id="dot-lab" class="dot"></span><span id="lab-state">@T["status.lab.checking"]</span>. <span id="dot-data" class="dot"></span><span id="data-state">@T["status.data.checking"]</span>.</p>
  <p class="status">@T.Html("guide.intro.map")</p>
</header>

<main>
<section class="col">
  <p>@T.Html("guide.intro.p1")</p>
  <p>@T.Html("guide.intro.p2")</p>
  <ol class="contents">
    @for (var n = 1; n <= chapters.Length; n++)
    {
      <li><a href="#s@(n)">@T[$"guide.s{n}.title"]</a></li>
    }
  </ol>
</section>

@for (var i = 0; i < chapters.Length; i++)
{
  var n = i + 1;
  var chapter = chapters[i];
  <section class="col chapter">
    <h2 id="s@(n)">@T[$"guide.s{n}.title"]</h2>
    @foreach (var p in chapter.Paragraphs)
    {
      <p>@T.Html($"guide.s{n}.{p}")</p>
    }
    <figure class="still">
      @{ var source = Url.Content($"~/static/figures/{chapter.Figure}.{T.Code}.svg"); }
      <a href="@source"><img src="@source" alt="@T[$"guide.fig{n}.alt"]" width="@chapter.Width" height="@chapter.Height"></a>
      <figcaption>@T[$"guide.fig{n}.title"]</figcaption>
    </figure>
    <p class="live"><a href="@Url.Content($"~/#step-{chapter.Step}")">@T[$"guide.s{n}.live"]</a></p>
    @if (n == 6)
    {
      <dl class="glossary" id="glossary"></dl>
    }
  </section>
}
</main>

<footer class="col">@T["guide.footer"]</footer>
