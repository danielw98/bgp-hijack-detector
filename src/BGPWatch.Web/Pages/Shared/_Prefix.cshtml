<div class="lanes prefix-view">
  <div class="choice-row">
    <span class="choice-label">@T["prefix.choice"]</span>
    <div class="seg-control" id="prefix-choice" role="group" aria-label="@T["prefix.choice.label"]"></div>
    <span class="choice-label push">@T["prefix.window"]</span>
    <div class="seg-control" id="window-choice" role="group" aria-label="@T["prefix.window.label"]">
      <button type="button" data-window="600" aria-pressed="true">10 min</button>
      <button type="button" data-window="3600" aria-pressed="false">@T["prefix.window.hour"]</button>
      <button type="button" data-window="86400" aria-pressed="false">24 h</button>
      <button type="button" data-window="0" aria-pressed="false">@T["prefix.window.all"]</button>
    </div>
  </div>
  <div class="verdict" id="prefix-verdict" aria-live="polite">@T["loading"]</div>
  <div class="lane-table" id="prefix-lanes" role="group" aria-label="@T["prefix.lanes.label"]"></div>
  <div class="more-row">
    <details>
      <summary id="prefix-changes-summary">@T["prefix.changes"]</summary>
      <div class="scroll-x" id="prefix-changes"></div>
    </details>
    <details>
      <summary id="prefix-alerts-summary">@T["prefix.alerts"]</summary>
      <div class="scroll-x" id="prefix-alerts"></div>
    </details>
    <details class="raw">
      <summary>@T["raw"]</summary>
      <pre id="raw-prefix"></pre>
    </details>
  </div>
</div>
