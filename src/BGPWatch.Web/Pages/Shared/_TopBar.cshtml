@{
    var page = (string?)ViewData["Page"] ?? "app";
    var onApp = page == "app";
    var view = (string name) => onApp ? $"#{name}" : Url.Content($"~/#{name}");
    var current = (string name) => page == name ? "page" : null;
}
<header class="topbar">
  <a class="brand" href="~/">@T["brand"]</a>
  <nav class="views" aria-label="@T["nav.views"]">
    <a href="@view("story")" data-view="story"><span class="num">1</span>@T["nav.story"]</a>
    <a href="@view("2008")" data-view="2008"><span class="num">2</span>@T["nav.2008"]</a>
    <a href="@view("prefixes")" data-view="prefixes"><span class="num">3</span>@T["nav.prefixes"]</a>
    <a href="@view("lookup")" data-view="lookup"><span class="num">4</span>@T["nav.lookup"]</a>
    <a href="@view("monitor")" data-view="monitor"><span class="num">5</span>@T["nav.monitor"]</a>
  </nav>
  <nav class="pages" aria-label="@T["nav.pages"]">
    <a class="guide @(page == "guide" ? "current" : "")" href="~/guide" aria-current="@current("guide")">@T["nav.guide"]</a>
    <a class="guide @(page == "references" ? "current" : "")" href="~/references" aria-current="@current("references")">@T["nav.references"]</a>
    @await Html.PartialAsync("_Language")
  </nav>
</header>
