<div class="sim" data-simulator>
  <div class="sim-toolbar">
    <div class="group">
      <span class="group-name">Deturnare</span>
      <label>scenariu
        <select data-sim="scenario">
          <option value="both">prefixul exact și sub-prefixul</option>
          <option value="exact">doar prefixul exact, 203.0.113.0/24</option>
          <option value="subprefix">doar sub-prefixul, 203.0.113.0/25</option>
        </select>
      </label>
      <button data-sim="hijack" class="btn red">Deturnează</button>
      <button data-sim="reset" class="btn outline">Retrage anunțurile</button>
    </div>
    <div class="group">
      <span class="group-name">Pachet</span>
      <label>de la <select data-sim="from"></select></label>
      <label>către <select data-sim="to"></select></label>
      <button data-sim="send" class="btn">Trimite pachetul</button>
      <button data-sim="ask" class="btn outline">Întreabă nucleele</button>
    </div>
    <p class="msg" data-sim="action-msg"></p>
  </div>

  <div class="sim-stage">
    <div class="sim-canvas" data-sim="canvas"></div>
    <dl class="sim-legend">
      <div><dt><span class="swatch session"></span></dt><dd>sesiune BGP</dd></div>
      <div><dt><span class="swatch report"></span></dt><dd>raportare BMP</dd></div>
      <div><dt><span class="swatch token update">UPDATE</span></dt><dd>mesaj BGP</dd></div>
      <div><dt><span class="swatch token packet">pachet</span></dt><dd>pachet simulat</dd></div>
    </dl>
  </div>

  <div class="sim-transport">
    <button data-sim="back" class="btn outline">Înapoi</button>
    <button data-sim="play" class="btn">Pauză</button>
    <button data-sim="step" class="btn outline">Pas</button>
    <label class="speed">viteză <input type="range" data-sim="speed" min="0" max="4" step="1" value="2" aria-label="viteza redării"> <b data-sim="speed-label">1x</b></label>
    <span class="count" data-sim="count"></span>
    <button data-sim="clear" class="btn outline">Șterge evenimentele</button>
    <button data-sim="toggle-events" class="btn outline" aria-expanded="true">Evenimente</button>
  </div>
  <ol class="evlist" data-sim="events"></ol>

  <aside class="sim-inspector">
    <div class="tabs" role="tablist">
      <button class="tab current" role="tab" aria-selected="true" data-tab="tables">Tabele BGP</button>
      <button class="tab" role="tab" aria-selected="false" data-tab="incidents">Incidente</button>
      <button class="tab" role="tab" aria-selected="false" data-tab="raw">Date brute</button>
    </div>
    <div class="panel" data-panel="tables"><div class="ribs" data-sim="tables"><div class="empty">Se citesc tabelele...</div></div></div>
    <div class="panel" data-panel="incidents" hidden><div id="incidents" class="feed"><div class="empty">Se încarcă...</div></div></div>
    <div class="panel raw" data-panel="raw" hidden>
      <h4>Starea ruterelor, așa cum o dă vtysh</h4>
      <pre id="raw-lab"></pre>
      <h4>Incidentele și ultimele 200 de alerte</h4>
      <pre id="raw-incidents"></pre>
    </div>
    <footer class="sim-foot">
      <p>Rețea închisă, fără uplink: numere AS private, prefixul de documentație 203.0.113.0/24 (RFC 5737), nimic nu părăsește calculatorul.</p>
      <p><button id="btn-clear" class="btn outline red small">Golește istoricul simulatorului</button> <span id="clear-msg" class="msg"></span></p>
    </footer>
  </aside>
</div>
