<div class="lanes" data-incident-2008>
  <div class="transport-row">
    <button id="btn-play" class="btn">@T["i2008.play"]</button>
    <span id="scrub-time" class="mono"></span>
    <span class="count attacker" id="count-hijacker"></span>
    <span class="count victim" id="count-owner"></span>
    <span class="speed" id="speed-2008">@T["sim.speed"]</span>
  </div>
  <div class="event-card" id="event-card" aria-live="polite"></div>
  <div class="lane-table" id="lanes" role="group" aria-label="@T["i2008.lanes.label"]"></div>
  <div class="more-row">
    <details>
      <summary>@T["i2008.events"]</summary>
      <ol class="events" id="events"></ol>
    </details>
    <details>
      <summary>@T["i2008.first"]</summary>
      <div class="scroll-x" id="peers-2008"></div>
    </details>
    <details class="raw">
      <summary>@T["raw"]</summary>
      <p class="caption" id="msg-2008">@T["loading"]</p>
      <pre id="raw-2008"></pre>
      <div class="drawer-actions"><button id="btn-reload" class="btn outline small">@T["i2008.reload"]</button><span class="msg">@T["i2008.reload.note"]</span></div>
    </details>
  </div>
</div>
