<div class="lanes" data-incident-2008>
  <div class="transport-row">
    <button id="btn-play" class="btn">Redă</button>
    <span id="scrub-time" class="mono"></span>
    <span class="count attacker" id="count-hijacker"></span>
    <span class="count victim" id="count-owner"></span>
    <span class="speed">viteză 180x</span>
  </div>
  <div class="event-card" id="event-card" aria-live="polite"></div>
  <div class="lane-table" id="lanes" role="group" aria-label="Pentru fiecare vecin al colectorului: cui îi trimitea traficul pentru blocul deturnat, de-a lungul timpului, și calea AS la momentul ales"></div>
  <div class="more-row">
    <details>
      <summary>Evenimentele documentate de RIPE NCC</summary>
      <ol class="events" id="events"></ol>
    </details>
    <details>
      <summary>Prima observare la fiecare vecin</summary>
      <div class="scroll-x" id="peers-2008"></div>
    </details>
    <details class="raw">
      <summary>Date brute</summary>
      <p class="caption" id="msg-2008">Se încarcă...</p>
      <pre id="raw-2008"></pre>
      <div class="drawer-actions"><button id="btn-reload" class="btn outline small">Reîncarcă incidentul din fișiere</button><span class="msg">Șterge și rescrie rândurile incidentului; simulatorul nu este atins.</span></div>
    </details>
  </div>
</div>
