# Which FRR daemons the lab routers run. Only zebra + bgpd + staticd are needed
# for a control-plane BGP lab; bgpd loads the BMP module to report to the station.
bgpd=yes
zebra=yes
staticd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
bgpd_options="   -A 127.0.0.1 -M bmp"
staticd_options="-A 127.0.0.1"
